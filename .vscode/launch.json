{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "UI: Next.js dev",
            "type": "node",
            "request": "launch",
            "preLaunchTask": "prepare-ui-next-cache",
            "program": "${workspaceFolder}/UI/node_modules/next/dist/bin/next",
            "args": ["dev"],
            "cwd": "${workspaceFolder}/UI",
            "runtimeExecutable": "node",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "- Local:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "api: host dev",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/api/src/host/node_modules/.bin/tsx",
            "runtimeArgs": ["watch", "--inspect"],
            "program": "${workspaceFolder}/api/src/host/src/main.ts",
            "cwd": "${workspaceFolder}/api/src/host",
            "envFile": "${workspaceFolder}/api/src/host/.env",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "listening on\\s+(https?://\\S+)",
                "uriFormat": "%s/ui"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        }
    ],
    "compounds": [
        {
            "name": "UI + API: 同時起動",
            "configurations": [
                "api: host dev",
                "UI: Next.js dev"
            ]
        }
    ]
}
