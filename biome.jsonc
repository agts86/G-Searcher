{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/coverage",
      "!**/TestResults",
      "!**/pnpm-lock.yaml",
      "!**/*.d.ts"
    ]
  },
  "formatter": {
    "enabled": true
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
