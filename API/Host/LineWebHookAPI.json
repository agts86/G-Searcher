  "components": {
    "schemas": {
      "DeliveryContextInfo": {
        "type": "object",
        "properties": {
          "isRedelivery": {
            "type": "boolean"
          }
        }
      },
      "ErrorLog": {
        "required": [
          "contents"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "contents": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Event": {
        "required": [
          "mode",
          "webhookEventId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "mode": {
            "type": [
              "null",
              "string"
            ]
          },
          "timestamp": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "source": {
            "$ref": "#/components/schemas/UserSource"
          },
          "webhookEventId": {
            "type": [
              "null",
              "string"
            ]
          },
          "deliveryContext": {
            "$ref": "#/components/schemas/DeliveryContextInfo"
          }
        }
      },
      "IMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "JobLog": {
        "required": [
          "isSuccess"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "isSuccess": {
            "type": "boolean"
          },
          "contents": {
            "type": [
              "null",
              "string"
            ]
          },
          "info": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginRequestDto": {
        "required": [
          "userName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 1,
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "minLength": 1,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LoginResponseDto": {
        "required": [
          "userName",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MeResponseDto": {
        "required": [
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MessageTypes": {
        "enum": [
          "location",
          "text"
        ]
      },
      "Reply": {
        "required": [
          "replyToken"
        ],
        "type": "object",
        "properties": {
          "replyToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "messages": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/IMessage"
            }
          }
        }
      },
      "UserSource": {
        "required": [
          "userId",
          "type"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "WebHook": {
        "type": "object",
        "properties": {
          "destination": {
            "type": [
              "null",
              "string"
            ]
          },
          "events": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Managed"
    },
    {
      "name": "Webhook"
    },
    {
      "name": "LineWebHookAPI"
    }
  ]
}