        ],
        "parameters": [
          {
            "name": "messageType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MessageTypes"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/managed/error-log": {
      "get": {
        "tags": [
          "Managed"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ErrorLog"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ErrorLog"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ErrorLog"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/managed/job-log": {
      "get": {
        "tags": [
          "Managed"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobLog"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobLog"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobLog"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/webhook/local/accept": {
      "post": {
        "tags": [
          "Webhook"
        ],
        "parameters": [
          {
            "name": "genreCode",
            "in": "query",
            "schema": {
              "maxLength": 7,
