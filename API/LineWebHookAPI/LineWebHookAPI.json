{
  "openapi": "3.0.1",
  "info": {
    "title": "LineWebHookAPI | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/HotPepper/gourmet/location": {
      "post": {
        "tags": [
          "HotPepper"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GourmetGettingDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GourmetGettingDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GourmetGettingDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Managed/gourmet": {
      "get": {
        "tags": [
          "Managed"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeliveryContextInfo": {
        "type": "object",
        "properties": {
          "isRedelivery": {
            "type": "boolean"
          }
        },
        "nullable": true
      },
      "GourmetEvent": {
        "required": [
          "type",
          "mode",
          "webhookEventId",
          "replyToken",
          "message"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "$ref": "#/components/schemas/UserSource"
          },
          "webhookEventId": {
            "type": "string",
            "nullable": true
          },
          "deliveryContext": {
            "$ref": "#/components/schemas/DeliveryContextInfo"
          },
          "replyToken": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "$ref": "#/components/schemas/LocationMessage"
          }
        }
      },
      "GourmetGettingDto": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "nullable": true
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GourmetEvent"
            },
            "nullable": true
          }
        }
      },
      "LocationMessage": {
        "required": [
          "id",
          "type"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "id": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          }
        },
        "nullable": true
      },
      "UserSource": {
        "required": [
          "userId",
          "type"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          }
        },
        "nullable": true
      }
    }
  },
  "tags": [
    {
      "name": "HotPepper"
    },
    {
      "name": "Managed"
    }
  ]
}