{
  "openapi": "3.0.1",
  "info": {
    "title": "LineWebHookAPI | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/managed/gourmet/{messageType}": {
      "get": {
        "tags": [
          "Managed"
        ],
        "parameters": [
          {
            "name": "messageType",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "location",
                "text"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/managed/error-log": {
      "get": {
        "tags": [
          "Managed"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ErrorLog"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ErrorLog"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ErrorLog"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/yahoo/local": {
      "post": {
        "tags": [
          "Yahoo"
        ],
        "parameters": [
          {
            "name": "genreCode",
            "in": "query",
            "schema": {
              "maxLength": 7,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebHook"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/WebHook"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WebHook"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reply"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reply"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reply"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeliveryContextInfo": {
        "type": "object",
        "properties": {
          "isRedelivery": {
            "type": "boolean"
          }
        },
        "nullable": true
      },
      "ErrorLog": {
        "required": [
          "contents"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "contents": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Event": {
        "required": [
          "mode",
          "webhookEventId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "$ref": "#/components/schemas/UserSource"
          },
          "webhookEventId": {
            "type": "string",
            "nullable": true
          },
          "deliveryContext": {
            "$ref": "#/components/schemas/DeliveryContextInfo"
          }
        }
      },
      "IMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Reply": {
        "required": [
          "replyToken"
        ],
        "type": "object",
        "properties": {
          "replyToken": {
            "type": "string",
            "nullable": true
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IMessage"
            },
            "nullable": true
          }
        }
      },
      "UserSource": {
        "required": [
          "userId",
          "type"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          }
        },
        "nullable": true
      },
      "WebHook": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "nullable": true
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Managed"
    },
    {
      "name": "Yahoo"
    }
  ]
}