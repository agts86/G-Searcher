{
  "openapi": "3.0.1",
  "info": {
    "title": "LineWebHookAPI | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/hot-pepper/gourmet/location": {
      "post": {
        "tags": [
          "HotPepper"
        ],
        "parameters": [
          {
            "name": "genreCode",
            "in": "query",
            "schema": {
              "enum": [
                "G001",
                "G002",
                "G003",
                "G004",
                "G005",
                "G006",
                "G007",
                "G008",
                "G009",
                "G010",
                "G011",
                "G012",
                "G013",
                "G014",
                "G015",
                "G016",
                "G017"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebHook"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/WebHook"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WebHook"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/managed/gourmet/{messageType}": {
      "get": {
        "tags": [
          "Managed"
        ],
        "parameters": [
          {
            "name": "messageType",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "location",
                "text"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/managed/error-log": {
      "get": {
        "tags": [
          "Managed"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/yahoo/local": {
      "post": {
        "tags": [
          "Yahoo"
        ],
        "parameters": [
          {
            "name": "genreCode",
            "in": "query",
            "schema": {
              "maxLength": 7,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebHook"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/WebHook"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WebHook"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeliveryContextInfo": {
        "type": "object",
        "properties": {
          "isRedelivery": {
            "type": "boolean"
          }
        },
        "nullable": true
      },
      "Event": {
        "required": [
          "mode",
          "webhookEventId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "$ref": "#/components/schemas/UserSource"
          },
          "webhookEventId": {
            "type": "string",
            "nullable": true
          },
          "deliveryContext": {
            "$ref": "#/components/schemas/DeliveryContextInfo"
          }
        }
      },
      "UserSource": {
        "required": [
          "userId",
          "type"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          }
        },
        "nullable": true
      },
      "WebHook": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "nullable": true
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "HotPepper"
    },
    {
      "name": "Managed"
    },
    {
      "name": "Yahoo"
    }
  ]
}