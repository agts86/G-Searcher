{
  "name": "@api/features-managed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "lint": "eslint src test --ext .ts"
  },
  "dependencies": {
    "@api/shared": "workspace:*",
    "@api/tables": "workspace:*",
    "hono": "^4.6.0",
    "zod": "^3.24.0",
    "@hono/zod-openapi": "^0.18.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.10.0"
  }
}
