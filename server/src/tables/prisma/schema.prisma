generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 既存.NET側 API/Tables/Models/DB/Tables/RefreshToken.cs と同じ物理テーブル/カラムにマッピングする。
// このPhaseでは prisma migrate は実行しない（EF Coreが引き続きスキーマの記録上の所有者）。
model RefreshToken {
  id        String   @id @default(uuid()) @map("Id") @db.Uuid
  userName  String   @map("UserName")
  tokenHash String   @unique @map("TokenHash")
  expiresAt DateTime @map("ExpiresAt") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("RefreshToken")
}

// 以下、Managed機能で参照する既存.NET側 API/Tables/Models/DB/Tables/*.cs のテーブル。
// PK以外のインデックスなし。DB側デフォルト値なし（アプリ側でIdを生成する）。

model GourmetLocationLog {
  id        String   @id @default(uuid()) @map("Id") @db.Uuid
  lat       Float    @map("Lat")
  lng       Float    @map("Lng")
  createdAt DateTime @default(now()) @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.Timestamptz(6)

  @@map("GourmetLocationLog")
}

model GourmetWordLog {
  id        String   @id @default(uuid()) @map("Id") @db.Uuid
  text      String?  @map("Text")
  createdAt DateTime @default(now()) @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.Timestamptz(6)

  @@map("GourmetWordLog")
}

model ErrorLog {
  id        String   @id @default(uuid()) @map("Id") @db.Uuid
  contents  String   @map("Contents")
  createdAt DateTime @default(now()) @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.Timestamptz(6)

  @@map("ErrorLog")
}

model JobLog {
  id        String   @id @default(uuid()) @map("Id") @db.Uuid
  isSuccess Boolean  @map("IsSuccess")
  contents  String?  @map("Contents")
  info      String?  @map("Info")
  createdAt DateTime @default(now()) @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.Timestamptz(6)

  @@map("JobLog")
}
