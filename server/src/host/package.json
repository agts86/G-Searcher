{
	"name": "@api/host",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsx watch --conditions=development --inspect --env-file=.env src/main.ts",
		"start": "tsx src/main.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
		"lint": "eslint src --ext .ts"
	},
	"dependencies": {
		"@api/features-auth": "workspace:*",
		"@api/features-managed": "workspace:*",
		"@api/features-webhook": "workspace:*",
		"@api/infrastructure": "workspace:*",
		"@api/shared": "workspace:*",
		"@hono/node-server": "^1.13.0",
		"@hono/swagger-ui": "^0.5.0",
		"@hono/zod-openapi": "^0.18.0",
		"hono": "^4.12.30"
	},
	"devDependencies": {
		"@api/tables": "workspace:*",
		"@types/node": "^22.10.0",
		"tsx": "^4.19.0",
		"typescript": "^6.0.0",
		"vitest": "^3.0.0"
	}
}
