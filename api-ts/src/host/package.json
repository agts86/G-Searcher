{
  "name": "@api-ts/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@api-ts/features-auth": "workspace:*",
    "@api-ts/features-managed": "workspace:*",
    "@api-ts/infrastructure": "workspace:*",
    "@api-ts/shared": "workspace:*",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0",
    "vitest": "^3.0.0"
  }
}
