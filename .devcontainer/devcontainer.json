{
  "name": "LineWebHookAPI",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "server",
  "workspaceFolder": "/workspaces/LineWebHookAPI",
  "remoteUser": "root",
  "forwardPorts": [3000, 3001, 5432],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "cd /workspaces/LineWebHookAPI/server && pnpm install --store-dir /tmp/pnpm-store && pnpm --filter @api/tables exec prisma generate"
}
